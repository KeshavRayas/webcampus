# ─────────────────────────────────────────────────────────────────────────────
# WebCampus environment — SINGLE SOURCE OF TRUTH
#
# Copy to .env and fill in the secret values. This file is committed to the
# repo; .env is git-ignored.
#
# Consumed by:
#   - apps/api, apps/web, packages/db scripts  (via `--env-file=../.env`)
#   - docker compose (packages/db dev stack + compose.prod.yaml at repo root)
#
# On the college server, set these to the server's address (step 3):
#   BETTER_AUTH_URL / FRONTEND_URL / MINIO_ENDPOINT / NEXT_PUBLIC_* / DATABASE_*
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure: PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=webcampus

# ── Infrastructure: MinIO root credentials ───────────────────────────────────
MINIO_ROOT_USER=webcampus
MINIO_ROOT_PASSWORD=example1

# ── Database URLs ────────────────────────────────────────────────────────────
# Unpooled (direct to Postgres :5432) — used ONLY for Prisma migrations.
DATABASE_UNPOOLED_URL="postgresql://postgres:example@localhost:5432/webcampus"
# Pooled (via PgBouncer :6432) — used by the API at runtime.
# connection_limit=20 keeps a single API instance from overwhelming PgBouncer.
DATABASE_URL="postgresql://postgres:example@localhost:6432/webcampus?connection_limit=20&pgbouncer=true"

# ── API: auth ────────────────────────────────────────────────────────────────
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://<SERVER_IP>:8080 on the college server
BETTER_AUTH_URL=http://localhost:8080
PORT=8080
# http://<SERVER_IP>:3000 on the college server
FRONTEND_URL=http://localhost:3000

# ── API: email (Google app password, 2FA enabled) ────────────────────────────
GMAIL_APP_PASSWORD=''
SENDER_EMAIL=''

# ── API: default super admin account (created by `bun run bootstrap`) ────────
ADMIN_USER_NAME='developer'
ADMIN_USER_EMAIL='dev@webcampus.com'
ADMIN_USER_PASSWORD='password'
ADMIN_USER_USERNAME='developer'

# ── API: default admission account (created by `bun run bootstrap`) ──────────
ADMISSION_USER_NAME='admission'
ADMISSION_USER_EMAIL='admission@webcampus.com'
ADMISSION_USER_PASSWORD='password'
ADMISSION_USER_USERNAME='admission'

# ── API: Puppeteer (hall-ticket PDFs) ────────────────────────────────────────
# Path to Chromium/Chrome. Container default: /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# ── API: MinIO application credentials ───────────────────────────────────────
# Access key must match MINIO_ROOT_USER; secret must match MINIO_ROOT_PASSWORD.
MINIO_ACCESS_KEY_ID=webcampus
MINIO_SECRET_ACCESS_KEY=example1
MINIO_REGION=us-east-1
MINIO_BUCKET_NAME=webcampus-uploads
MINIO_BUCKET=webcampus-uploads
# http://<SERVER_IP>:9000 on the college server (must be browser-reachable)
MINIO_ENDPOINT=http://localhost:9000

# ── API: Redis ───────────────────────────────────────────────────────────────
# Container hostname on the college server: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Web (NEXT_PUBLIC_*, baked into the build) ────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# ── Optional integrations ────────────────────────────────────────────────────
# WhatsApp broadcast (Trustsignal)
TRUSTSIGNAL_API_KEY=''
WHATSAPP_SENDER_NUMBER=''
# SMS broadcast (Versatile SMS Hub)
SMS_API_KEY=''
SMS_SENDER_ID=''
SMS_API_URL='https://sms.versatilesmshub.com/api/smsservices.php'

# ── Legacy (unused — kept only for backward compatibility) ───────────────────
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=your-aws-region
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_S3_BUCKET=your-bucket-name