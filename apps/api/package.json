{
  "name": "@webcampus/api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env --bun src/index.ts",
    "lint": "eslint .",
    "build": "tsup",
    "start": "bun --env-file=../../.env run dist/index.js",
    "seed": "bun --env-file=../../.env run tsx scripts/seed.ts",
    "seed:ci": "bun --env-file=../../.env run tsx scripts/seed-ci.ts",
    "mock:start": "bun --env-file=../../.env run tsx scripts/mock_start.ts",
    "mock:admission-constants": "bun --env-file=../../.env run tsx scripts/seed-admission-constants.ts",
    "submit:mock-applicant": "bun --env-file=../../.env run tsx scripts/submit-mock-applicant.ts",
    "cleanup:mock-applicants": "bun --env-file=../../.env run tsx scripts/cleanup-mock-applicants.ts",
    "rewrite:admission-usn": "bun --env-file=../../.env run tsx scripts/rewrite-admission-usn.ts",
    "backfill:current-student-emails": "bun --env-file=../../.env run tsx scripts/backfill-current-student-emails.ts",
    "check-types": "tsc --noEmit --pretty",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "bootstrap": "bun --env-file=../../.env tsx scripts/admin.ts"
  },
  "devDependencies": {
    "@eslint/css": "^0.9.0",
    "@eslint/js": "^9.30.1",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.6.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^11.0.0",
    "@webcampus/typescript-config": "*",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.36.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1007.0",
    "@aws-sdk/s3-request-presigner": "3.1088.0",
    "@faker-js/faker": "^9.9.0",
    "@webcampus/auth": "*",
    "@webcampus/backend-utils": "*",
    "@webcampus/common": "*",
    "@webcampus/db": "*",
    "@webcampus/schemas": "*",
    "@webcampus/types": "*",
    "@webcampus/ui": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^13.0.0"
  }
}
