BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
PORT=8080
FRONTEND_URL=http://localhost:3000

# You can get this from your google account (2FA should be enabled)
GMAIL_APP_PASSWORD=''
SENDER_EMAIL=''

# WhatsApp broadcast (Trustsignal)
TRUSTSIGNAL_API_KEY=''
WHATSAPP_SENDER_NUMBER=''

# SMS broadcast (Versatile SMS Hub)
SMS_API_KEY=''
SMS_SENDER_ID=''
SMS_API_URL='https://sms.versatilesmshub.com/api/smsservices.php'

# Default super admin account
ADMIN_USER_NAME='developer'
ADMIN_USER_EMAIL='dev@webcampus.com'
ADMIN_USER_PASSWORD='password'
ADMIN_USER_USERNAME='developer'

# Default admission account
ADMISSION_USER_NAME='admission'
ADMISSION_USER_EMAIL='admission@webcampus.com'
ADMISSION_USER_PASSWORD='password'
ADMISSION_USER_USERNAME='admission'

# Path to Chromium/Chrome executable for Puppeteer PDF generation
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BUCKET=your-bucket-name

MINIO_ACCESS_KEY_ID=webcampus                   # MINIO_ROOT_USER
MINIO_SECRET_ACCESS_KEY=example1                # MINIO_ROOT_PASSWORD
MINIO_REGION=us-east-1                          # Default
MINIO_BUCKET_NAME=webcampus-uploads
MINIO_BUCKET=webcampus-uploads
MINIO_ENDPOINT=http://localhost:9000            # The local MinIO API URL

# Redis Configuration
REDIS_URL=redis://localhost:6379