model AdminEditLog {
  id            String          @id @default(uuid())
  changeGroupId String          // UUID grouping all changes from one save
  entityId      String
  entityType    AuditEntityType // "COURSE" | "COURSE_ASSIGNMENT" | "COORDINATOR" | etc.
  courseId      String?         // always set for new rows; nullable for backward compat
  fieldName     String?         // per-field name: "facultyId", "credits", etc.
  oldValue      Json?
  newValue      Json?
  action        AuditAction     // SUPER_EDIT, UPSERT_MAPPING, DELETE_MAPPING, UPDATE_COORDINATOR
  reason        String?         // required when entity is locked/approved
  ipAddress     String?
  userAgent     String?
  details       String?         // preserved for backward compat (existing records)
  adminUserId   String
  editedAt      DateTime        @default(now())
  
  adminUser   User     @relation(fields: [adminUserId], references: [id])

  @@index([entityType, entityId])
  @@index([changeGroupId])
  @@index([courseId])
  @@index([editedAt])
  @@index([adminUserId])
}


model CourseMappingAuditLog {
  id           String   @id @default(uuid())
  courseId     String
  adminId      String
  action       String   // e.g., "SUPER_EDIT_MAPPING"
  details      String?  // JSON string storing the exact changes made
  createdAt    DateTime @default(now())

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  admin        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([adminId])
}

model Finance {
  id           String           @id @default(uuid())
  studentId    String
  academicYear String
  finalFee     Float            @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments     FinancePayment[]

  @@unique([studentId, academicYear])
  @@index([studentId])
  @@index([academicYear])
}

model FinancePayment {
  id        String   @id @default(uuid())
  financeId String
  amount    Float
  paidAt    DateTime @default(now())
  reference String?
  remarks   String?
  createdAt DateTime @default(now())
  finance   Finance  @relation(fields: [financeId], references: [id], onDelete: Cascade)

  @@index([financeId])
  @@index([paidAt])
}
