generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id
  name                  String
  email                 String           @unique
  emailVerified         Boolean
  image                 String?
  createdAt             DateTime
  updatedAt             DateTime
  username              String?          @unique
  displayUsername       String?
  banned                Boolean?
  banReason             String?
  banExpires            DateTime?
  role                  String?
  admin                 Admin?
  coe                   Coe?
  Department            Department[]
  departmentMemberships DepartmentUser[]
  faculty               Faculty?
  frozenAsAdmin         Freeze[]         @relation("FrozenByAdmin")
  frozenAsFaculty       Freeze[]         @relation("FrozenByFaculty")
  frozenAsHod           Freeze[]         @relation("FrozenByHod")
  Freeze                Freeze[]
  hod                   Hod?
  Semester              Semester[]
  student               Student?
  accounts              Account[]
  sessions              Session[]

  @@map("user")
}

model AcademicTerm {
  id        String       @id @default(uuid())
  type      SemesterType
  year      String
  isCurrent Boolean      @default(false)
  Semester  Semester[]
  registrationWindows RegistrationWindow[]
  courseRegistrations   CourseRegistration[]

  @@unique([type, year])
}

model Semester {
  id             String       @id @default(uuid())
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  semesterNumber Int
  academicTermId String
  programType    ProgramType
  Admission      Admission[]
  Course         Course[]
  registrationWindows RegistrationWindow[]
  courseRegistrations   CourseRegistration[]
  Section        Section[]
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [userId], references: [id])

  @@unique([academicTermId, programType, semesterNumber])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Department {
  id                String             @id @default(uuid())
  userId            String
  name              String             @unique
  abbreviation      String
  code              String             @unique
  type              DepartmentType     @default(DEGREE_GRANTING)
  Admissions        Admission[]
  Course            Course[]
  courseAssignments CourseAssignment[]
  user              User               @relation(fields: [userId], references: [id])
  userMemberships   DepartmentUser[]
  faculties         Faculty[]
  hods              Hod[]
  sections          Section[]
  students          Student[]
  registrationWindows RegistrationWindow[]

  @@index([name])
}

model RegistrationWindow {
  id             String   @id @default(uuid())
  academicTermId String
  semesterId     String
  departmentId   String?
  cycle          Cycle?
  isOpen         Boolean  @default(false)

  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  semester     Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([academicTermId, semesterId, departmentId, cycle])
  @@index([academicTermId, semesterId])
}

model DepartmentUser {
  id           String               @id @default(uuid())
  userId       String
  departmentId String
  role         DepartmentScopedRole
  isPrimary    Boolean              @default(false)
  department   Department           @relation(fields: [departmentId], references: [id])
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, role])
  @@index([departmentId, role])
}

model Hod {
  id             String      @id @default(uuid())
  userId         String      @unique
  departmentName String?
  facultyId      String?     @unique
  department     Department? @relation(fields: [departmentName], references: [name])
  faculty        Faculty?    @relation(fields: [facultyId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
}

model Section {
  id              String             @id @default(uuid())
  name            String
  departmentName  String?
  semesterId      String
  cycle           Cycle              @default(NONE)
  departmentId    String
  batches         Batch[]
  ClassSession    ClassSession[]
  courses         CourseAssignment[]
  department      Department         @relation(fields: [departmentId], references: [id])
  semester        Semester           @relation(fields: [semesterId], references: [id])
  studentSections StudentSection[]

  @@unique([id, departmentId])
  @@unique([name, departmentId, semesterId])
  @@index([departmentId, semesterId])
  @@index([departmentId, semesterId, cycle])
}

/// *
///  * TODO Change the Name of this model to support L-T-P
model Batch {
  id               String             @id @default(uuid())
  name             String
  sectionId        String
  section          Section            @relation(fields: [sectionId], references: [id])
  ClassSession     ClassSession[]
  CourseAssignment CourseAssignment[]
  students         Student[]          @relation("BatchStudents")

  @@unique([name, sectionId])
  @@index([sectionId])
}

model StudentSection {
  id           String  @id @default(uuid())
  studentId    String
  sectionId    String
  semester     Int
  academicYear String
  section      Section @relation(fields: [sectionId], references: [id])
  student      Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, sectionId, semester, academicYear])
  @@index([studentId])
  @@index([sectionId])
  @@index([sectionId, semester, academicYear])
}

model Student {
  id                String               @id @default(uuid())
  userId            String               @unique
  usn               String               @unique
  departmentName    String
  currentSemester   Int
  academicYear      String
  academicTermId    String?
  academicTermLabel String?
  academicTermType  SemesterType?
  academicTermYear  String?
  programType       ProgramType?
  semesterId        String?
  semesterNumber    Int?
  admission         Admission?
  attendances       Attendance[]
  AttendanceRecord  AttendanceRecord[]
  registrations     CourseRegistration[]
  assessments       StudentAssessment[]
  marks             Mark[]
  department        Department           @relation(fields: [departmentName], references: [name])
  user              User                 @relation(fields: [userId], references: [id])
  studentSections   StudentSection[]
  batches           Batch[]              @relation("BatchStudents")

  @@index([departmentName])
  @@index([departmentName, currentSemester])
  @@index([semesterId])
  @@index([semesterNumber])
  @@index([programType])
  @@index([academicTermId])
}

model Faculty {
  id                     String                 @id @default(uuid())
  userId                 String                 @unique
  departmentId           String
  designation            Designation
  shortName              String
  aboutYourself          String?
  alternateContactNumber String?
  bloodGroup             String?
  contactInformation     String?
  dateOfJoining          DateTime?
  dob                    DateTime?
  employeeId             String?                @unique
  gender                 FacultyGender?
  maritalStatus          MaritalStatus?
  mobileNumber           String?
  nationality            String?
  officeRoom             String?
  otherInformation       String?
  permanentAddressLine   String?
  permanentCity          String?
  permanentPincode       String?
  permanentState         String?
  personalEmail          String?
  phoneNumber            String?
  presentAddressLine     String?
  presentCity            String?
  presentPincode         String?
  presentState           String?
  profileUpdatedAt       DateTime?
  qualification          String?
  researchArea           String?
  researchInterests      String?
  sameAsPresentAddress   Boolean                @default(false)
  staffType              StaffType?
  ClassSession           ClassSession[]
  teaches                CourseAssignment[]
  coordinatedCourses     CourseCoordinator[]
  department             Department             @relation(fields: [departmentId], references: [id])
  user                   User                   @relation(fields: [userId], references: [id])
  experiences            FacultyExperience[]
  publications           FacultyPublication[]
  qualifications         FacultyQualification[]
  hod                    Hod?

  @@unique([id, departmentId])
  @@index([departmentId])
}

model FacultyQualification {
  id             String                   @id @default(uuid())
  facultyId      String
  program        String
  degree         String
  specialization String
  institution    String
  programType    QualificationProgramType
  yearPassed     Int
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  faculty        Faculty                  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model FacultyPublication {
  id                 String              @id @default(uuid())
  facultyId          String
  category           PublicationCategory
  publishedDate      DateTime
  authors            String
  publicationDetails String
  weblink            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model FacultyExperience {
  id              String    @id @default(uuid())
  facultyId       String
  designation     String
  institutionName String
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  faculty         Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Course {
  id                      String               @id @default(uuid())
  code                    String               @unique
  name                    String
  departmentName          String?
  semesterId              String
  semesterNumber          Int
  assignmentMaxMarks      Int                  @default(0)
  cieMaxMarks             Int                  @default(0)
  cieMinMarks             Int                  @default(0)
  cieWeightage            Int                  @default(0)
  courseMode              CourseMode
  courseType              CourseType
  cumulativeMaxMarks      Int                  @default(0)
  cumulativeMinMarks      Int                  @default(0)
  hasLaboratoryComponent  Boolean              @default(false)
  labMaxMarks             Int                  @default(0)
  labMinMarks             Int                  @default(0)
  labWeightage            Int                  @default(0)
  lectureCredits          Int                  @default(0)
  maxNoOfCies             Int                  @default(0)
  minNoOfCies             Int                  @default(0)
  noOfAssignments         Int                  @default(0)
  practicalCredits        Int                  @default(0)
  seeMaxMarks             Int                  @default(0)
  seeMinMarks             Int                  @default(0)
  seeWeightage            Int                  @default(0)
  skillCredits            Int                  @default(0)
  totalCredits            Int
  tutorialCredits         Int                  @default(0)
  cycle                   Cycle                @default(NONE)
  approvalStatus          CourseApprovalStatus @default(DRAFT)
  departmentId            String
  approvedByRole          String?
  approvedByUsername      String?
  approvedByDisplay       String?
  approvedAt              DateTime?
  revisionRequestedByRole String?
  revisionNotes           String?
  revisionRequestedAt     DateTime?
  attendances             Attendance[]
  ClassSession            ClassSession[]
  coordinators            CourseCoordinator[]
  assessments             AssessmentTemplate[]
  department              Department           @relation(fields: [departmentId], references: [id])
  semester                Semester             @relation(fields: [semesterId], references: [id])
  assignments             CourseAssignment[]
  registrations           CourseRegistration[]
  marks                   Mark[]
  studentAssessments      StudentAssessment[]

  @@unique([id, departmentId])
  @@index([code])
  @@index([departmentId, semesterId])
  @@index([departmentId, semesterId, cycle, approvalStatus])
  @@index([departmentId, semesterId, semesterNumber])
}

model CourseAssignment {
  id             String         @id @default(uuid())
  courseId       String
  facultyId      String
  sectionId      String
  batchId        String?
  assignmentType AssignmentType
  semester       Int
  academicYear   String
  departmentId   String
  batch          Batch?         @relation(fields: [batchId], references: [id])
  course         Course         @relation(fields: [courseId, departmentId], references: [id, departmentId])
  department     Department     @relation(fields: [departmentId], references: [id])
  faculty        Faculty        @relation(fields: [facultyId], references: [id])
  section        Section        @relation(fields: [sectionId, departmentId], references: [id, departmentId])
  freezes        Freeze?

  @@unique([departmentId, courseId, facultyId, sectionId, batchId, assignmentType, semester, academicYear])
  @@index([sectionId, semester])
  @@index([departmentId, sectionId, semester])
  @@index([departmentId, courseId, semester])
  @@index([courseId, semester, academicYear])
  @@index([facultyId, semester, academicYear])
  @@index([batchId])
}

model CourseRegistration {
  id               String       @id @default(uuid())
  studentId        String
  courseId         String
  semesterId       String
  academicTermId   String
  registrationDate DateTime     @default(now())
  academicTerm     AcademicTerm @relation(fields: [academicTermId], references: [id])
  course           Course       @relation(fields: [courseId], references: [id])
  semester         Semester     @relation(fields: [semesterId], references: [id])
  student          Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([academicTermId])
}

model Attendance {
  id                String            @id @default(uuid())
  studentId         String
  courseId          String
  total             Int
  present           Int
  absent            Int
  condonationStatus CondonationStatus @default(NOT_REQUESTED)
  percentage        Float
  course            Course            @relation(fields: [courseId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Mark {
  id        String            @id @default(uuid())
  studentId String
  courseId  String
  cie1      Float?
  cie2      Float?
  cie3      Float?
  aat1      Float?
  aat2      Float?
  lab1      Float?
  lab2      Float?
  labTotal  Float?
  cieTotal  Float?
  status    EligibilityStatus
  course    Course            @relation(fields: [courseId], references: [id])
  student   Student           @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Coe {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Freeze {
  id                 String           @id @default(uuid())
  courseAssignmentId String           @unique
  cie1Frozen         Boolean          @default(false)
  cie2Frozen         Boolean          @default(false)
  cie3Frozen         Boolean          @default(false)
  cie1Deadline       DateTime?
  cie2Deadline       DateTime?
  cie3Deadline       DateTime?
  facultyFrozen      Boolean          @default(false)
  hodFrozen          Boolean          @default(false)
  adminFrozen        Boolean          @default(false)
  facultyFrozenAt    DateTime?
  hodFrozenAt        DateTime?
  adminFrozenAt      DateTime?
  frozenByFacultyId  String?
  frozenByHodId      String?
  frozenByAdminId    String?
  finalFrozen        Boolean          @default(false)
  finalDeadline      DateTime?
  frozenAt           DateTime?
  userId             String?
  courseAssignment   CourseAssignment @relation(fields: [courseAssignmentId], references: [id])
  frozenByAdmin      User?            @relation("FrozenByAdmin", fields: [frozenByAdminId], references: [id])
  frozenByFaculty    User?            @relation("FrozenByFaculty", fields: [frozenByFacultyId], references: [id])
  frozenByHod        User?            @relation("FrozenByHod", fields: [frozenByHodId], references: [id])
  User               User?            @relation(fields: [userId], references: [id])
}

model Admission {
  id                              String          @id @default(uuid())
  gender                          String?
  fatherName                      String?
  motherName                      String?
  fatherEmail                     String?
  motherEmail                     String?
  fatherNumber                    String?
  motherNumber                    String?
  class10thMarksPdf               String?
  class12thMarksPdf               String?
  class10thSchoolName             String?
  modeOfAdmission                 String
  photo                           String?
  createdAt                       DateTime        @default(now())
  applicationId                   String          @unique
  casteCertificate                String?
  semesterId                      String
  status                          AdmissionStatus @default(PENDING)
  updatedAt                       DateTime        @updatedAt
  aadharCard                      String?
  aadharNumber                    String?         @unique
  bloodGroup                      String?
  caste                           String?
  class10thAggregateScore         Float?
  class10thAggregateTotal         Float?
  class10thMediumOfTeaching       String?
  class10thSchoolCity             String?
  class10thSchoolCode             String?
  class10thSchoolState            String?
  class10thSchoolType             String?
  class10thYearOfPassing          String?
  class12thAggregateScore         Float?
  class12thAggregateTotal         Float?
  class12thBranch                 String?
  class12thInstituteCity          String?
  class12thInstituteCode          String?
  class12thInstituteName          String?
  class12thInstituteState         String?
  class12thInstituteType          String?
  class12thMediumOfTeaching       String?
  class12thYearOfPassing          String?
  currentAddress                  String?
  currentArea                     String?
  currentCity                     String?
  currentCountry                  String?
  currentDistrict                 String?
  currentPincode                  String?
  currentState                    String?
  disability                      Boolean?
  disabilityCertificate           String?
  disabilityType                  String?
  dob                             DateTime?
  economicallyBackward            Boolean?
  economicallyBackwardCertificate String?
  emergencyContactNumber          String?
  entranceExamRank                String?
  fatherQualification             String?
  fatherOccupation                String?
  fatherPermanentAddress          String?
  feePaid                         Float?
  feePayable                      Float?
  firstName                       String?
  guardianEmail                   String?
  guardianName                    String?
  guardianNumber                  String?
  guardianOccupation              String?
  guardianPermanentAddress        String?
  hostel                          Boolean?
  hostelRoomNumber                String?
  lastName                        String?
  middleName                      String?
  motherQualification             String?
  motherOccupation                String?
  motherPermanentAddress          String?
  motherTongue                    String?
  nameAsPer10th                   String?
  nationality                     String?
  nri                             Boolean?
  originalAdmissionOrderDate      DateTime?
  originalAdmissionOrderNumber    String?
  passportNumber                  String?
  permanentAddress                String?
  permanentArea                   String?
  permanentCity                   String?
  permanentCountry                String?
  permanentDistrict               String?
  permanentPincode                String?
  permanentState                  String?
  placeOfBirth                    String?
  primaryEmail                    String?         @unique
  primaryPhoneNumber              String?
  religion                        String?
  secondaryEmail                  String?
  secondaryPhoneNumber            String?
  stateOfBirth                    String?
  studyCertificate                String?
  subCaste                        String?
  tempUsn                         String?         @unique
  transferCertificate             String?
  uniqueId                        String?         @unique
  visaValidityDetails             String?
  departmentId                    String
  studentId                       String?         @unique
  categoryAllotted                Category
  categoryClaimed                 Category
  quota                           Quota
  department                      Department      @relation(fields: [departmentId], references: [id])
  semester                        Semester        @relation(fields: [semesterId], references: [id])
  student                         Student?        @relation(fields: [studentId], references: [id])

  @@index([semesterId])
  @@index([departmentId])
}

model AttendanceRecord {
  id           String           @id
  sessionId    String
  studentId    String
  status       AttendanceStatus
  markedAt     DateTime         @default(now())
  ClassSession ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Student      Student          @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model ClassSession {
  id               String             @id
  courseId         String
  sectionId        String
  facultyId        String
  batchId          String?
  sessionDate      DateTime
  createdAt        DateTime           @default(now())
  timingCode       String
  timingLabel      String
  timingStartTime  String
  timingEndTime    String
  AttendanceRecord AttendanceRecord[]
  Batch            Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  Course           Course             @relation(fields: [courseId], references: [id])
  Faculty          Faculty            @relation(fields: [facultyId], references: [id])
  Section          Section            @relation(fields: [sectionId], references: [id])

  @@unique([courseId, sectionId, sessionDate, timingCode, batchId])
  @@index([courseId])
  @@index([sectionId])
  @@index([batchId])
}

model CourseCoordinator {
  id        String  @id @default(uuid())
  courseId  String
  facultyId String

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyId])
  @@index([courseId])
}

model AssessmentTemplate {
  id         String   @id @default(uuid())
  courseId   String
  semesterId String
  title      String
  totalMarks Int

  questions AssessmentQuestion[]
  studentRecords StudentAssessment[]
  course    Course              @relation(fields: [courseId], references: [id])
}

model AssessmentQuestion {
  id           String @id @default(uuid())
  assessmentId String
  part         String
  qNumber      String
  marks        Int
  co           String?
  po           String?
  bl           String?
  orGroupId    String?

  assessment AssessmentTemplate @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentMarks StudentQuestionMark[]
}

model StudentAssessment {
  id              String   @id @default(uuid())
  studentId       String
  assessmentId    String
  courseId        String
  totalMarks      Float
  status          String   @default("PRESENT")

  student       Student             @relation(fields: [studentId], references: [id])
  assessment    AssessmentTemplate  @relation(fields: [assessmentId], references: [id])
  course        Course              @relation(fields: [courseId], references: [id])
  questionMarks StudentQuestionMark[]

  @@unique([studentId, assessmentId])
}

model StudentQuestionMark {
  id            String   @id @default(uuid())
  recordId      String
  questionId    String
  marksObtained Float

  record   StudentAssessment  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id])

  @@unique([recordId, questionId])
}

enum DepartmentScopedRole {
  ADMIN
  HOD
  FACULTY
  STAFF
  VIEWER
}

enum SemesterType {
  even
  odd
}

enum ProgramType {
  UG
  PG
}

enum CourseMode {
  INTEGRATED
  NON_INTEGRATED
  FINAL_SUMMARY
  NCMC
}

enum CourseType {
  PC
  PE
  OE
  NCMC
}

enum CondonationStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
}

enum AssignmentType {
  THEORY
  LAB
}

enum Designation {
  ASSOCIATE_PROFESSOR
  ASSISTANT_PROFESSOR
  PROFESSOR
  VISITING_PROFESSOR
}

enum StaffType {
  TEMPORARY
  REGULAR
  POP
  ADJUNCT
}

enum FacultyGender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum QualificationProgramType {
  FULL_TIME
  PART_TIME
}

enum PublicationCategory {
  JOURNAL
  CONFERENCE
  BOOK_CHAPTER_OR_BOOK
  CASE_STUDY
  PATENT
}

enum AdmissionStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum Category {
  GENERAL
  OBC
  SC
  ST
}

enum Quota {
  MERIT
  MANAGEMENT
  SPORTS
  NRI
  SNQ
}

enum DepartmentType {
  DEGREE_GRANTING
  BASIC_SCIENCES
  SERVICE
}

enum Cycle {
  PHYSICS
  CHEMISTRY
  NONE
}

enum CourseApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  NEEDS_REVISION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}
