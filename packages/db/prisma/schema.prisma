generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id
  name                  String
  email                 String           @unique
  emailVerified         Boolean
  image                 String?
  createdAt             DateTime
  updatedAt             DateTime
  username              String?          @unique
  displayUsername       String?
  banned                Boolean?
  banReason             String?
  banExpires            DateTime?
  role                  String?
  admin                 Admin?
  coe                   Coe?
  Department            Department[]
  departmentMemberships DepartmentUser[]
  faculty               Faculty?

  hod                         Hod?
  Semester                    Semester[]
  student                     Student?
  accounts                    Account[]
  sessions                    Session[]
  adminEditLogs               AdminEditLog[]
  feedbackQuestionSetsCreated FeedbackQuestionSet[]
  feedbackRoundsCreated       FeedbackRound[]
  feedbackPresetsCreated      FeedbackQuestionPreset[]
  cancelledAdmissions             CancelledAdmissions[]
  filledAdmissions            Admission[] @relation("AdmissionFilledBy")

  courseMappingAuditLogs CourseMappingAuditLog[]
  supportTicketsCreated  SupportTicket[]         @relation("SupportTicketCreator")
  supportMessages        SupportTicketMessage[]  @relation("SupportMessageAuthor")

  @@map("user")
}

model AcademicTerm {
  id                      String                   @id @default(uuid())
  type                    SemesterType
  year                    String
  isCurrent               Boolean                  @default(false)
  Semester                Semester[]
  registrationWindows     RegistrationWindow[]
  courseRegistrations     CourseRegistration[]
  hallTickets             HallTicket[]
  feedbackQuestionSets    FeedbackQuestionSet[]
  feedbackRounds          FeedbackRound[]
  feedbackQuestionPresets FeedbackQuestionPreset[]
  bonusAttendanceWindows BonusAttendanceWindow[]
  hallTicketVerificationSettings HallTicketVerificationSetting[]
  hallTicketVerificationLogs     HallTicketVerificationLog[]

  @@unique([type, year])
}

model Semester {
  id                  String               @id @default(uuid())
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userId              String
  semesterNumber      Int
  academicTermId      String
  programType         ProgramType
  Admission           Admission[]
  Course              Course[]
  registrationWindows RegistrationWindow[]
  courseRegistrations CourseRegistration[]
  Section             Section[]
  hallTickets         HallTicket[]
  feedbackQuestionSet FeedbackQuestionSet?
  feedbackRounds      FeedbackRound[]
  bonusAttendanceWindows BonusAttendanceWindow[]
  academicTerm        AcademicTerm         @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation(fields: [userId], references: [id])

  @@unique([academicTermId, programType, semesterNumber])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Department {
  id                  String               @id @default(uuid())
  userId              String
  name                String               @unique
  abbreviation        String
  code                String               @unique
  type                DepartmentType       @default(DEGREE_GRANTING)
  Admissions          Admission[]
  Course              Course[]
  courseAssignments   CourseAssignment[]
  user                User                 @relation(fields: [userId], references: [id])
  userMemberships     DepartmentUser[]
  faculties           Faculty[]
  hods                Hod[]
  sections            Section[]
  students            Student[]
  registrationWindows RegistrationWindow[]
  openElectiveCourses     OpenElectiveDepartment[]
  bonusAttendanceWindows  BonusAttendanceWindow[]
  proctorGroups           ProctorGroup[]

  @@index([name])
}

model RegistrationWindow {
  id             String  @id @default(uuid())
  academicTermId String
  semesterId     String
  departmentId   String?
  cycle          Cycle?
  isOpen         Boolean @default(false)

  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  semester     Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([academicTermId, semesterId, departmentId, cycle])
  @@index([academicTermId, semesterId])
}

model BonusAttendanceWindow {
  id             String    @id @default(uuid())
  academicTermId String
  semesterId     String
  departmentId   String?
  cycle          Cycle?
  days           Int       @default(1)
  isOpen         Boolean   @default(false)
  openedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  semester     Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([academicTermId, semesterId, departmentId, cycle])
  @@index([academicTermId, semesterId])
}

model DepartmentUser {
  id           String               @id @default(uuid())
  userId       String
  departmentId String
  role         DepartmentScopedRole
  isPrimary    Boolean              @default(false)
  department   Department           @relation(fields: [departmentId], references: [id])
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, role])
  @@index([departmentId, role])
}

model Hod {
  id             String      @id @default(uuid())
  userId         String      @unique
  departmentName String?
  facultyId      String?     @unique
  department     Department? @relation(fields: [departmentName], references: [name])
  faculty        Faculty?    @relation(fields: [facultyId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
}

model Section {
  id              String             @id @default(uuid())
  name            String
  departmentName  String?
  semesterId      String
  cycle           Cycle              @default(NONE)
  departmentId    String
  batches         Batch[]
  electiveBatches ElectiveBatch[]
  ClassSession    ClassSession[]
  courses         CourseAssignment[]
  department      Department         @relation(fields: [departmentId], references: [id])
  semester        Semester           @relation(fields: [semesterId], references: [id])
  studentSections StudentSection[]

  @@unique([id, departmentId])
  @@unique([name, departmentId, semesterId])
  @@index([departmentId, semesterId])
  @@index([departmentId, semesterId, cycle])
}


/// *
///  * TODO Change the Name of this model to support L-T-P
model Batch {
  id               String             @id @default(uuid())
  name             String
  sectionId        String
  section          Section            @relation(fields: [sectionId], references: [id])
  ClassSession     ClassSession[]
  CourseAssignment CourseAssignment[]
  students         Student[]          @relation("BatchStudents")

  attendances       Attendance[] // <-- NEW: Back-relation
  attendanceRecords AttendanceRecord[] // <-- NEW: Back-relation

  @@unique([name, sectionId])
  @@index([sectionId])
}

model StudentSection {
  id           String  @id @default(uuid())
  studentId    String
  sectionId    String
  semester     Int
  academicYear String
  section      Section @relation(fields: [sectionId], references: [id])
  student      Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, sectionId, semester, academicYear])
  @@index([studentId])
  @@index([sectionId])
  @@index([sectionId, semester, academicYear])
}

model Student {
  id                String               @id @default(uuid())
  userId            String               @unique
  usn               String               @unique
  departmentName    String
  currentSemester   Int
  academicYear      String
  academicTermId    String?
  academicTermLabel String?
  academicTermType  SemesterType?
  academicTermYear  String?
  programType       ProgramType?
  semesterId        String?
  semesterNumber    Int?
  admission         Admission?
  attendances       Attendance[]
  AttendanceRecord  AttendanceRecord[]
  registrations     CourseRegistration[]
  assessments       StudentAssessment[]
  marks             Mark[]
  department        Department           @relation(fields: [departmentName], references: [name])
  user              User                 @relation(fields: [userId], references: [id])
  feedbackResponses FeedbackResponse[]
  studentSections            StudentSection[]
  batches                    Batch[]                     @relation("BatchStudents")
  hallTickets                HallTicket[]
  hallTicketVerificationLogs HallTicketVerificationLog[]
  finances                   Finance[]
  electiveStudentAssignments ElectiveStudentAssignment[]

  proctorGroupId    String?
  proctorGroup      ProctorGroup?        @relation(fields: [proctorGroupId], references: [id], onDelete: SetNull)

  @@index([departmentName])
  @@index([departmentName, currentSemester])
  @@index([semesterId])
  @@index([semesterNumber])
  @@index([programType])
  @@index([academicTermId])
}

model Faculty {
  id                     String                 @id @default(uuid())
  userId                 String                 @unique
  departmentId           String
  designation            Designation
  shortName              String
  aboutYourself          String?
  alternateContactNumber String?
  bloodGroup             String?
  contactInformation     String?
  dateOfJoining          DateTime?
  dob                    DateTime?
  employeeId             String?                @unique
  gender                 FacultyGender?
  maritalStatus          MaritalStatus?
  mobileNumber           String?
  nationality            String?
  officeRoom             String?
  otherInformation       String?
  permanentAddressLine   String?
  permanentCity          String?
  permanentPincode       String?
  permanentState         String?
  personalEmail          String?
  phoneNumber            String?
  presentAddressLine     String?
  presentCity            String?
  presentPincode         String?
  presentState           String?
  profileUpdatedAt       DateTime?
  qualification          String?
  researchArea           String?
  researchInterests      String?
  sameAsPresentAddress   Boolean                @default(false)
  staffType              StaffType?
  ClassSession           ClassSession[]
  teaches                CourseAssignment[]
  coordinatedCourses     CourseCoordinator[]
  electiveBatchFaculties ElectiveBatchFaculty[]
  department             Department             @relation(fields: [departmentId], references: [id])
  user                   User                   @relation(fields: [userId], references: [id])
  experiences            FacultyExperience[]
  publications           FacultyPublication[]
  qualifications         FacultyQualification[]
  hod                    Hod?
  feedbackAssignments    FeedbackResponse[]
  proctorGroups          ProctorGroup[]

  @@unique([id, departmentId])
  @@index([departmentId])
}

model FacultyQualification {
  id             String                   @id @default(uuid())
  facultyId      String
  program        String
  degree         String
  specialization String
  institution    String
  programType    QualificationProgramType
  yearPassed     Int
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  faculty        Faculty                  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model FacultyPublication {
  id                 String              @id @default(uuid())
  facultyId          String
  category           PublicationCategory
  publishedDate      DateTime
  authors            String
  publicationDetails String
  weblink            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model FacultyExperience {
  id              String    @id @default(uuid())
  facultyId       String
  designation     String
  institutionName String
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  faculty         Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Course {
  id             String     @id @default(uuid())
  code           String     @unique
  name           String
  departmentName String?
  departmentId   String
  semesterId     String
  semesterNumber Int
  courseMode     CourseMode
  courseType     CourseType
  cycle          Cycle      @default(NONE)

  // Credit fields (L-T-P-S)
  lectureCredits   Int @default(0)
  tutorialCredits  Int @default(0)
  practicalCredits Int @default(0)
  skillCredits     Int @default(0)
  totalCredits     Int

  // Computed Field
  hasLaboratoryComponent Boolean @default(false)

  // ─── NEW CONFIGURATION FIELDS ───

  // SEE
  seeMaxMarks    Int @default(0)
  seeEligibility Int @default(40)

  // CIE
  cieMaxMarks          Int                  @default(0)
  cieEligibility       Int                  @default(40)
  cieEligibilityPolicy CieEligibilityPolicy @default(COMPONENT_AND_OVERALL)

  // Theory Exam
  theoryExamMaxMarks    Int @default(0)
  theoryMaxExams        Int @default(0)
  theoryMinExams        Int @default(0)
  theoryCieContribution Int @default(0)
  theoryEligibility     Int @default(40)

  // Lab
  labMaxMarks    Int @default(0)
  labEligibility Int @default(40)

  // AAT
  aatMaxMarks    Int @default(0)
  aatEligibility Int @default(40)

  // Settings
  allowFeedback      Boolean @default(false)
  attendanceRequired Boolean @default(true)

  // ─── PROGRAM ELECTIVE (PE) CONFIG ───
  numberOfBatches         Int?
  studentsPerBatch        Int?
  electiveMappingVersion  Int  @default(1)

  // ─── OPEN ELECTIVE (OE) CONFIG ───
  openElectiveEligibility OpenElectiveEligibility @default(ALL)

  // ─── PROJECT / MINI-PROJECT (PW) CONFIG ───
  projectGroupingScope      ProjectGroupingScope @default(WITHIN_SECTION)
  nextProjectGroupSequence  Int                   @default(0)

  // ─── APPROVAL & TRACKING FIELDS ───
  approvalStatus          CourseApprovalStatus @default(DRAFT)
  approvedByRole          String?
  approvedByUsername      String?
  approvedByDisplay       String?
  approvedAt              DateTime?
  revisionRequestedByRole String?
  revisionNotes           String?
  revisionRequestedAt     DateTime?
  version                 Int                  @default(1)
  lastOverrideAt          DateTime?
  lastOverrideById        String?
  overrideCount           Int                  @default(0)
  hasPostApprovalEdits    Boolean              @default(false)

  // ─── RELATIONS ───
  department               Department                   @relation(fields: [departmentId], references: [id])
  semester                 Semester                     @relation(fields: [semesterId], references: [id])
  attendances              Attendance[]
  ClassSession             ClassSession[]
  coordinators             CourseCoordinator[]
  assessments              AssessmentTemplate[]
  assignments              CourseAssignment[]
  registrations            CourseRegistration[]
  marks                    Mark[]
  studentAssessments       StudentAssessment[]
  mappingAuditLogs         CourseMappingAuditLog[]
  electiveBatches          ElectiveBatch[]
  electiveBatchFaculties   ElectiveBatchFaculty[]
  electiveStudentAssignments ElectiveStudentAssignment[]
  openElectiveDepartments  OpenElectiveDepartment[]
  feedbackResponses  FeedbackResponse[]

  // ─── INDEXES ───
  @@unique([id, departmentId])
  @@index([code])
  @@index([departmentId, semesterId])
  @@index([departmentId, semesterId, cycle, approvalStatus])
  @@index([departmentId, semesterId, semesterNumber])
}

model CourseAssignment {
  id                String             @id @default(uuid())
  courseId          String
  facultyId         String
  sectionId         String
  batchId           String?
  assignmentType    AssignmentType
  semester          Int
  academicYear      String
  departmentId      String
  batch             Batch?             @relation(fields: [batchId], references: [id])
  course            Course             @relation(fields: [courseId, departmentId], references: [id, departmentId])
  department        Department         @relation(fields: [departmentId], references: [id])
  faculty           Faculty            @relation(fields: [facultyId], references: [id])
  section           Section            @relation(fields: [sectionId, departmentId], references: [id, departmentId])
  freezes           Freeze?
  feedbackResponses FeedbackResponse[]

  @@unique([departmentId, courseId, facultyId, sectionId, batchId, assignmentType, semester, academicYear])
  @@index([sectionId, semester])
  @@index([departmentId, sectionId, semester])
  @@index([departmentId, courseId, semester])
  @@index([courseId, semester, academicYear])
  @@index([facultyId, semester, academicYear])
  @@index([batchId])
}

model CourseRegistration {
  id               String       @id @default(uuid())
  studentId        String
  courseId         String
  semesterId       String
  academicTermId   String
  registrationDate DateTime     @default(now())
  academicTerm     AcademicTerm @relation(fields: [academicTermId], references: [id])
  course           Course       @relation(fields: [courseId], references: [id])
  semester         Semester     @relation(fields: [semesterId], references: [id])
  student          Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([academicTermId])
}

model FeedbackQuestionSet {
  id             String   @id @default(uuid())
  academicTermId String
  semesterId     String   @unique
  isLocked       Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicTerm AcademicTerm            @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  semester     Semester                @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation(fields: [createdById], references: [id])
  questions    FeedbackQuestion[]
  rounds       FeedbackRound[]
  presetId     String?
  preset       FeedbackQuestionPreset? @relation(fields: [presetId], references: [id])

  @@unique([academicTermId, semesterId])
  @@index([academicTermId])
}

model FeedbackQuestionPreset {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  academicTermId String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicTerm AcademicTerm?                @relation(fields: [academicTermId], references: [id], onDelete: SetNull)
  createdBy    User                         @relation(fields: [createdById], references: [id])
  questions    FeedbackQuestionPresetItem[]
  questionSets FeedbackQuestionSet[]
}

model FeedbackQuestionPresetItem {
  id             String @id @default(uuid())
  presetId       String
  questionNumber Int
  questionText   String

  preset FeedbackQuestionPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, questionNumber])
}

model FeedbackQuestion {
  id             String   @id @default(uuid())
  questionSetId  String
  questionNumber Int
  questionText   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questionSet FeedbackQuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  answers     FeedbackAnswer[]

  @@unique([questionSetId, questionNumber])
  @@index([questionSetId])
}

model FeedbackRound {
  id             String   @id @default(uuid())
  academicTermId String
  semesterId     String
  questionSetId  String
  roundNumber    Int
  name           String   @default("")
  startsAt       DateTime
  endsAt         DateTime
  isEnabled      Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicTerm AcademicTerm        @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  semester     Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  questionSet  FeedbackQuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdById], references: [id])
  responses    FeedbackResponse[]

  @@unique([academicTermId, semesterId, roundNumber])
  @@index([semesterId, startsAt, endsAt])
}

model FeedbackResponse {
  id                      String   @id @default(uuid())
  feedbackRoundId         String
  studentId               String
  courseAssignmentId      String?
  electiveBatchFacultyId  String?
  courseId                String
  facultyId               String
  sectionId               String
  batchId                 String?
  submittedAt             DateTime @default(now())

  feedbackRound           FeedbackRound           @relation(fields: [feedbackRoundId], references: [id], onDelete: Cascade)
  student                 Student                 @relation(fields: [studentId], references: [id])
  courseAssignment        CourseAssignment?       @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  electiveBatchFaculty    ElectiveBatchFaculty?   @relation(fields: [electiveBatchFacultyId], references: [id], onDelete: Cascade)
  course                  Course                  @relation(fields: [courseId], references: [id])
  faculty                 Faculty                 @relation(fields: [facultyId], references: [id])
  answers                 FeedbackAnswer[]

  @@unique([studentId, feedbackRoundId, courseAssignmentId])
  @@unique([studentId, feedbackRoundId, electiveBatchFacultyId])
  @@index([feedbackRoundId, courseAssignmentId])
  @@index([feedbackRoundId, electiveBatchFacultyId])
  @@index([facultyId, feedbackRoundId])
  @@index([courseId, sectionId, feedbackRoundId])
}

model FeedbackAnswer {
  id         String @id @default(uuid())
  responseId String
  questionId String
  score      Int

  response FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question FeedbackQuestion @relation(fields: [questionId], references: [id])

  @@unique([responseId, questionId])
  @@index([questionId])
}

model Attendance {
  id                String            @id @default(uuid())
  studentId         String
  courseId          String
  batchId           String? // lab batch (section-scoped)
  electiveBatchId   String? // PE elective batch
  total             Int
  present           Int
  absent            Int
  condonationStatus CondonationStatus @default(NOT_REQUESTED)
  percentage        Float
  course            Course            @relation(fields: [courseId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])
  batch             Batch?            @relation(fields: [batchId], references: [id])
  electiveBatch     ElectiveBatch?    @relation(fields: [electiveBatchId], references: [id])

  @@unique([studentId, courseId, batchId, electiveBatchId])
  @@index([courseId])
  @@index([batchId])
  @@index([electiveBatchId])
}

model Mark {
  id        String            @id @default(uuid())
  studentId String
  courseId  String
  cie1      Float?
  cie2      Float?
  cie3      Float?
  aat1      Float?
  aat2      Float?
  lab1      Float?
  lab2      Float?
  labTotal  Float?
  cieTotal  Float?
  status    EligibilityStatus
  course    Course            @relation(fields: [courseId], references: [id])
  student   Student           @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Coe {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Freeze {
  id                      String                 @id @default(uuid())
  courseAssignmentId      String?                @unique
  electiveBatchFacultyId  String?                @unique
  cie1Frozen         Boolean          @default(false)
  cie2Frozen         Boolean          @default(false)
  cie3Frozen         Boolean          @default(false)
  cie1Deadline       DateTime?
  cie2Deadline       DateTime?
  cie3Deadline       DateTime?
  facultyFrozen      Boolean          @default(false)
  hodFrozen          Boolean          @default(false)
  adminFrozen        Boolean          @default(false)
  facultyFrozenAt    DateTime?
  hodFrozenAt        DateTime?
  adminFrozenAt      DateTime?
  finalFrozen        Boolean          @default(false)
  finalDeadline      DateTime?
  frozenByRole       FreezeActorRole?
  frozenByUsername   String?
  frozenByDisplay    String?
  courseAssignment   CourseAssignment? @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  electiveBatchFaculty ElectiveBatchFaculty? @relation(fields: [electiveBatchFacultyId], references: [id], onDelete: Cascade)
}

model HallTicket {
  id                String    @id @default(uuid())
  studentId         String
  academicTermId    String
  semesterId        String
  isSent            Boolean   @default(false)
  sentAt            DateTime?
  sentBy            String?
  verificationToken String?   @unique

  student      Student      @relation(fields: [studentId], references: [id])
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id])

  @@unique([studentId, academicTermId, semesterId])
  @@index([studentId])
  @@index([academicTermId])
  @@index([semesterId])
  @@index([verificationToken])
}

model HallTicketVerificationSetting {
  id             String    @id @default(uuid())
  academicTermId String    @unique
  enabled        Boolean   @default(false)
  windowStartAt  DateTime?
  windowEndAt    DateTime?
