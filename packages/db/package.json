{
  "name": "@webcampus/db",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit --pretty",
    "lint": "eslint .",
    "db:generate": "bun --env-file=../../.env run prisma generate",
    "db:push": "bun --env-file=../../.env run prisma db push",
    "db:migrate": "bun --env-file=../../.env run prisma migrate dev --skip-generate",
    "db:deploy": "bun --env-file=../../.env run prisma migrate deploy",
    "db:studio": "bun --env-file=../../.env run prisma studio",
    "db:reset": "bun --env-file=../../.env run prisma migrate reset -f",
    "db:nuke": "docker compose --env-file=../../.env down --volumes || docker-compose --env-file=../../.env down --volumes",
    "db:up": "docker compose --env-file=../../.env up -d || docker-compose --env-file=../../.env up -d",
    "db:setup": "run-s db:up db:generate",
    "dx": "run-s db:setup",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "postinstall": "bun --env-file=../../.env run prisma generate"
  },
  "devDependencies": {
    "@eslint/css": "^0.9.0",
    "@eslint/js": "^9.30.1",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.6.0",
    "@types/bun": "latest",
    "@webcampus/typescript-config": "*",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "typescript-eslint": "^8.36.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "5",
    "prisma": "5"
  }
}
